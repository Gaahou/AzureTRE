# Linux VM Environment Variables Template
# Populated by resource processor when deploying VM resource

# VM Identification
VM_ID=${VM_ID}
VM_TITLE=${VM_TITLE}
VM_HOSTNAME=${VM_HOSTNAME}

# Workspace Integration
WORKSPACE_ID=${WORKSPACE_ID}
WORKSPACE_STORAGE_PATH=/var/lib/docker/volumes/${WORKSPACE_ID}-storage-data/_data

# VM User Configuration
VM_USERNAME=${VM_USERNAME}
VM_USER_CREDENTIAL=${VM_USER_CREDENTIAL}

# VM Network Configuration
VM_PORT_HTTP=${VM_PORT_HTTP}
VM_PORT_HTTPS=${VM_PORT_HTTPS}

# System Configuration
TIMEZONE=Etc/UTC