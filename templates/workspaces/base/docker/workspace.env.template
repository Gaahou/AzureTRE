# Workspace Environment Variables Template
# This file is populated by the resource processor when deploying a workspace

# Workspace Identification
WORKSPACE_ID=ws-${WORKSPACE_NAME}
WORKSPACE_NAME=${WORKSPACE_NAME}
WORKSPACE_OWNER=${WORKSPACE_OWNER}

# Workspace Network Configuration
# Each workspace gets its own subnet to ensure isolation
WORKSPACE_SUBNET=172.20.${WORKSPACE_INDEX}.0/24

# Workspace Storage (Azurite) Configuration
WORKSPACE_STORAGE_ACCOUNT=${WORKSPACE_ID}storage
WORKSPACE_STORAGE_KEY=${WORKSPACE_STORAGE_KEY}
WORKSPACE_STORAGE_PORT_BLOB=${WORKSPACE_STORAGE_PORT_BLOB}
WORKSPACE_STORAGE_PORT_QUEUE=${WORKSPACE_STORAGE_PORT_QUEUE}
WORKSPACE_STORAGE_PORT_TABLE=${WORKSPACE_STORAGE_PORT_TABLE}
WORKSPACE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=${WORKSPACE_STORAGE_ACCOUNT};AccountKey=${WORKSPACE_STORAGE_KEY};BlobEndpoint=http://workspace-storage:10000/${WORKSPACE_STORAGE_ACCOUNT};QueueEndpoint=http://workspace-storage:10001/${WORKSPACE_STORAGE_ACCOUNT};TableEndpoint=http://workspace-storage:10002/${WORKSPACE_STORAGE_ACCOUNT};

# Workspace Key Vault (HashiCorp Vault) Configuration
WORKSPACE_VAULT_TOKEN=${WORKSPACE_VAULT_TOKEN}
WORKSPACE_VAULT_PORT=${WORKSPACE_VAULT_PORT}
WORKSPACE_VAULT_ADDR=http://workspace-vault:8200
WORKSPACE_VAULT_NAMESPACE=${WORKSPACE_ID}

# Workspace Resource Configuration
WORKSPACE_DESCRIPTION=${WORKSPACE_DESCRIPTION}
WORKSPACE_CREATED_DATE=${WORKSPACE_CREATED_DATE}
WORKSPACE_STATUS=deployed

# TRE Core Configuration
TRE_ID=${TRE_ID}
TRE_CORE_API_URL=${TRE_CORE_API_URL}
DEPLOYMENT_MODE=offline