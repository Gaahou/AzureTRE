        <!-- Critical Errors Box -->
        <mxCell id="errors-box" value="3 Critical Errors Fixed in Revised Plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#cc0000;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1580" width="1700" height="200" as="geometry" />
        </mxCell>

        <mxCell id="error1-box" value="ERROR 1: Authentication Misdiagnosis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1620" width="540" height="140" as="geometry" />
        </mxCell>

        <mxCell id="error1-text" value="Original plan assumed: Both apps use Keycloak, unify bootstrap&#xa;&#xa;Reality from code:&#xa;• Catalog uses @azure/msal-browser (MSAL) with ProtocolMode.OIDC → Keycloak&#xa;• Workspaces_UI uses keycloak-js 26.0.6 directly&#xa;• catalogApiService.ts in Workspaces calls Catalog backend using keycloak-js token&#xa;• Token compatibility is unknown — may already be broken in production&#xa;&#xa;Impact: Plan's '2-3 day' auth estimate → actually 3 weeks&#xa;&#xa;Fix: Phase 0 decision + Phase 2 dedicated auth unification (3 weeks)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1655" width="520" height="95" as="geometry" />
        </mxCell>

        <mxCell id="error2-box" value="ERROR 2: 'Workflows' Feature Does Not Exist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="1620" width="540" height="140" as="geometry" />
        </mxCell>

        <mxCell id="error2-text" value="Original plan: Phase 2.1 'Extract Workflows from iframe' (3-4 weeks)&#xa;&#xa;Reality from code:&#xa;• IFrame.tsx renders external VM apps: JupyterHub, RStudio, DBGate (third-party)&#xa;• 'GRIP Workflows' = single card loading REACT_APP_Workflow_URL in iframe (external link)&#xa;• No React feature module called 'Workflows' exists in either codebase&#xa;• 'Workflow' in Catalog = entity approval workflows (self-contained, no migration)&#xa;&#xa;Impact: Entire Phase 2.1 is phantom work&#xa;&#xa;Fix: Replace with VM iframe system migration (55 Redux slices) — 4 weeks" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="1655" width="520" height="95" as="geometry" />
        </mxCell>

        <mxCell id="error3-box" value="ERROR 3: Redux Situation Backwards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1620" width="540" height="140" as="geometry" />
        </mxCell>

        <mxCell id="error3-text" value="Original plan: 'Consolidate Redux stores'&#xa;&#xa;Reality from code:&#xa;• Workspaces_UI: 55+ Redux slices (VMs, airlock, file explorer, signalR, audit, etc.)&#xa;• Catalog: ZERO Redux — uses Context API + React Router v6 loaders/actions&#xa;• Two fundamentally different state paradigms&#xa;&#xa;Impact: Plan assumes merging two Redux stores; reality = choosing one paradigm&#xa;&#xa;Fix: Phase 0 decision — Option A (Redux scoped to workspaces, Context for&#xa;shared state) recommended as lowest-risk path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1655" width="520" height="95" as="geometry" />
        </mxCell>

