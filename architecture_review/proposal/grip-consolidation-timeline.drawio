        <mxCell id="risk3" value="3. Redux/Context boundary bugs • Likelihood: Medium • Impact: High&#xa;   Mitigation: Define boundary in Phase 0, enforce with ESLint (no Redux in catalog libs)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#cc0000;" vertex="1" parent="1">
          <mxGeometry x="920" y="1520" width="800" height="15" as="geometry" />
        </mxCell>

        <mxCell id="risk4" value="4. VM iframe sandbox breaks (CSP / origin restrictions) • Likelihood: Medium • Impact: High&#xa;   Mitigation: Test iframe rules early in Phase 3, not in Phase 6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#cc0000;" vertex="1" parent="1">
          <mxGeometry x="920" y="1540" width="800" height="15" as="geometry" />
        </mxCell>

        <mxCell id="risk5" value="5. Vendor feature merge conflicts • Likelihood: High • Impact: Medium&#xa;   Mitigation: Weekly sync meetings, consider feature freeze last 4 weeks" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#cc0000;" vertex="1" parent="1">
          <mxGeometry x="920" y="1560" width="800" height="15" as="geometry" />
