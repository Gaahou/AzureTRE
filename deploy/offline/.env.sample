# ===================================================================
# Azure TRE Offline Mode Configuration
# ===================================================================
# This file contains environment variables for running TRE locally
# with emulators instead of Azure cloud services.
#
# Copy this file to .env and customize as needed:
#   cp .env.sample .env
# ===================================================================

# -------------------------------------------------------------------
# Deployment Mode (SHARED)
# -------------------------------------------------------------------
# Controls which provider implementations are used
DEPLOYMENT_MODE=offline

# -------------------------------------------------------------------
# Cosmos DB Emulator (EMULATOR-SPECIFIC)
# -------------------------------------------------------------------
# Cosmos DB emulator connection settings
# The emulator uses a fixed well-known key for local development
COSMOSDB_ACCOUNT_NAME=localhost
COSMOSDB_ACCOUNT_URI=https://cosmosdb:8081
STATE_STORE_ENDPOINT=https://cosmosdb:8081
STATE_STORE_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# Database name (SHARED)
STATE_STORE_DATABASE=AzureTRE

# Container names (SHARED)
STATE_STORE_RESOURCES_CONTAINER=Resources
STATE_STORE_RESOURCE_TEMPLATES_CONTAINER=ResourceTemplates
STATE_STORE_RESOURCE_HISTORY_CONTAINER=ResourceHistory
STATE_STORE_OPERATIONS_CONTAINER=Operations
STATE_STORE_REQUESTS_CONTAINER=Requests
STATE_STORE_AIRLOCK_REQUESTS_CONTAINER=AirlockRequests
STATE_STORE_AIRLOCK_REQUESTS_HISTORY_CONTAINER=AirlockRequestsHistory

# -------------------------------------------------------------------
# Azurite Storage Emulator (EMULATOR-SPECIFIC)
# -------------------------------------------------------------------
# Azurite uses the standard Azure Storage Emulator connection string
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

# Storage container names (SHARED)
STORAGE_CONTAINER_NAME=tre-bundles
STORAGE_WORKSPACE_CONTAINER=workspaces

# -------------------------------------------------------------------
# Message Queue (Phase 2 - RabbitMQ)
# -------------------------------------------------------------------
# Service Bus namespace (will map to RabbitMQ in Phase 2)
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=localhost

# Queue names (SHARED)
SERVICE_BUS_RESOURCE_REQUEST_QUEUE=workspacequeue
SERVICE_BUS_DEPLOYMENT_STATUS_UPDATE_QUEUE=deploymentstatus
SERVICE_BUS_STEP_RESULT_QUEUE=step-result

# -------------------------------------------------------------------
# Event Grid (Phase 2 - RabbitMQ Topics)
# -------------------------------------------------------------------
# Event Grid topic endpoint (will map to RabbitMQ exchange in Phase 2)
EVENT_GRID_STATUS_CHANGED_TOPIC_ENDPOINT=http://localhost:5672/status-changed
EVENT_GRID_AIRLOCK_NOTIFICATION_TOPIC_ENDPOINT=http://localhost:5672/airlock-notification

# -------------------------------------------------------------------
# Authentication (Phase 3 - Keycloak)
# -------------------------------------------------------------------
# For Phase 1, authentication is disabled
# Phase 3 will integrate Keycloak for local auth
AAD_TENANT_ID=local
API_CLIENT_ID=tre-api-local
API_CLIENT_SECRET=local-secret

# Swagger UI (SHARED)
SWAGGER_UI_CLIENT_ID=tre-swagger-local

# -------------------------------------------------------------------
# TRE Core Configuration (SHARED)
# -------------------------------------------------------------------
# TRE instance identifier
TRE_ID=tre-local

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Enable/disable features
ENABLE_SWAGGER=true
ENABLE_AIRLOCK=false
ENABLE_MALWARE_SCANNING=false

# Logging
LOG_LEVEL=DEBUG

# -------------------------------------------------------------------
# Resource Processor (Phase 4)
# -------------------------------------------------------------------
# Porter bundle repository
PORTER_BUNDLE_REPOSITORY=localhost:5000
TERRAFORM_STATE_CONTAINER_NAME=terraform-state

# Docker configuration (for resource processor)
DOCKER_REGISTRY_SERVER=localhost:5000

# -------------------------------------------------------------------
# Azure-specific (ONLINE MODE ONLY)
# -------------------------------------------------------------------
# These variables are not used in offline mode but kept for reference
# Uncomment and set when switching to DEPLOYMENT_MODE=online

# AZURE_SUBSCRIPTION_ID=<your-subscription-id>
# RESOURCE_GROUP_NAME=<your-rg-name>
# RESOURCE_GROUP_LOCATION=eastus
# ACR_NAME=<your-acr-name>

# -------------------------------------------------------------------
# Advanced Configuration
# -------------------------------------------------------------------
# Number of worker processes
API_WORKERS=1

# Request timeout
API_TIMEOUT=300

# CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# -------------------------------------------------------------------
# Notes
# -------------------------------------------------------------------
# EMULATOR-SPECIFIC: These values are specific to local emulators
#                    and should be changed when deploying to Azure
#
# SHARED: These values are used in both online and offline modes
#         (though the underlying implementation may differ)
#
# Phase-specific: Variables marked with phase numbers (Phase 2-4)
#                 will be fully implemented in those phases