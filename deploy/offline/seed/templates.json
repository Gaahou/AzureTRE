{
  "workspaceTemplates": [
    {
      "id": "tre-workspace-base",
      "name": "tre-workspace-base",
      "title": "Base Workspace",
      "description": "Base workspace template for local TRE development",
      "version": "0.1.0",
      "resourceType": "workspace",
      "current": true,
      "required": [],
      "properties": {
        "display_name": {
          "type": "string",
          "title": "Workspace Name",
          "description": "Name of the workspace"
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Workspace description"
        },
        "address_space": {
          "type": "string",
          "title": "Address Space",
          "description": "VNet address space (CIDR notation)",
          "default": "10.1.0.0/16"
        }
      },
      "actions": [
        {
          "name": "install",
          "description": "Install workspace"
        },
        {
          "name": "uninstall",
          "description": "Uninstall workspace"
        },
        {
          "name": "upgrade",
          "description": "Upgrade workspace"
        }
      ]
    }
  ],
