  "userResourceTemplates": [
    {
      "id": "tre-service-guacamole-linuxvm",
      "name": "tre-service-guacamole-linuxvm",
      "title": "Linux VM",
      "description": "Ubuntu Linux virtual machine accessible via Guacamole",
      "version": "0.1.0",
      "resourceType": "user-resource",
      "parentWorkspaceService": "tre-service-guacamole",
      "current": true,
      "required": [],
      "properties": {
        "display_name": {
          "type": "string",
          "title": "VM Name",
          "description": "Name of the Linux VM"
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "VM description"
        },
        "os_image": {
          "type": "string",
          "title": "OS Image",
          "description": "Operating system image",
          "enum": ["Ubuntu 20.04 LTS", "Ubuntu 22.04 LTS"],
          "default": "Ubuntu 22.04 LTS"
        },
        "vm_size": {
          "type": "string",
          "title": "VM Size",
          "description": "Azure VM size",
          "enum": ["Standard_B2s", "Standard_B2ms", "Standard_D2s_v3"],
          "default": "Standard_B2s"
        }
      },
      "actions": [
        {
          "name": "install",
          "description": "Create Linux VM"
        },
        {
          "name": "uninstall",
          "description": "Delete Linux VM"
        },
        {
          "name": "start",
          "description": "Start VM"
        },
        {
          "name": "stop",
          "description": "Stop VM"
        }
      ]
    },
    {
      "id": "tre-service-guacamole-windowsvm",
