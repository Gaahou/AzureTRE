        "os_image": {
          "type": "string",
          "title": "OS Image",
          "description": "Operating system image",
          "enum": ["Windows 10 Pro", "Windows 11 Pro", "Windows Server 2022"],
          "default": "Windows 11 Pro"
        },
        "vm_size": {
          "type": "string",
          "title": "VM Size",
          "description": "Azure VM size",
          "enum": ["Standard_B2s", "Standard_B2ms", "Standard_D2s_v3"],
          "default": "Standard_B2ms"
